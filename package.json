{
  "name": "@chroxify/eunoe",
  "version": "1.2.2",
  "description": "Context management for Claude Code that never forgets what matters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chroxify/eunoe.git"
  },
  "homepage": "https://github.com/chroxify/eunoe#readme",
  "bugs": "https://github.com/chroxify/eunoe/issues",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "context",
    "compaction",
    "proxy"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/core/index.ts",
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "eunoe": "src/cli/main.ts",
    "ee": "src/cli/main.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun src/cli/main.ts serve",
    "test": "bun test",
    "check-types": "tsc --noEmit -p .",
    "build:core": "bun scripts/build-core.ts",
    "lint": "biome check . && bun lint:conventions",
    "lint:conventions": "bun scripts/lint-conventions.ts",
    "format": "biome check .",
    "format:fix": "biome check . --write",
    "prepare": "husky",
    "prepublishOnly": "bun run build:core"
  },
  "devDependencies": {
    "@babel/parser": "7.27.0",
    "@biomejs/biome": "2.5.9",
    "@types/bun": "^1.4.2",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "16.4.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{js,ts,json,jsonc,md,yml}": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  }
}
