{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "types": ["bun-types"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "customConditions": ["bun"]
  },
  "include": ["src", "test", "bench", "scripts", "examples"],
  "exclude": ["node_modules", "bench/out", "bench/tools/models", "dist"]
}
